# CCB / Pushpay API
CCB_USERNAME=your_api_username
CCB_PASSWORD=your_api_password
CCB_BASE_URL=https://your-organization.example.com

# Google Calendar
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# Optional source-resource -> calendar/email mapping
MINISTRY_EMAIL_MAP_JSON={"Example Ministry":"example-calendar@group.calendar.google.com"}
